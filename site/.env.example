# ============================================================
# MEDIA AGENCY — Variables d'environnement
# Copiez ce fichier en .env et remplissez vos valeurs
# ============================================================

# Port du serveur (défaut: 3000)
PORT=3000

# Configuration SMTP
# Pour Gmail: host=smtp.gmail.com, port=465, secure=true
# Pour Hostinger: host=smtp.hostinger.com, port=465, secure=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=contact@agencymedia.fr
SMTP_PASS=VOTRE_MOT_DE_PASSE_SMTP

# Email destinataire des formulaires de contact
AGENCY_EMAIL=contact@agencymedia.fr
